 		*rocr = cmd.resp[mmc_host_is_spi(host) ? 1 : 0];
 
+	pr_info("=== [MMC_DEBUG] %s: CMD5 ocr=0x%08x err=%d resp[0]=0x%08x ===\n",
+		mmc_hostname(host), ocr, err, cmd.resp[0]);
+
 	return err;
 }
 
